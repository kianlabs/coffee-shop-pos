{
  "name": "coffee-shop-pos",
  "version": "1.0.1",
  "description": "Production-ready, offline-first Tablet POS for specialty coffee shops and slow bars. Features native SQLite V7, ESC/POS Bluetooth 58mm thermal printing with raster logo, recipe-based HPP costing, and zero cloud subscription cost.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-domain.mjs && node scripts/test-guards.mjs",
    "check": "node scripts/check-brand.mjs && node scripts/check-no-apk.mjs && node scripts/check-no-ai-files.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "test:e2e": "node scripts/test-e2e-exhaustive.mjs",
    "ota:pack": "node scripts/package-ota.mjs",
    "android:assets": "npm run build && node scripts/sync-android-assets.mjs",
    "apk": "bash scripts/build-apk.sh",
    "mock:sync": "node scripts/mock-sync-server.mjs --port 8787"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kianlabs/coffee-shop-pos.git"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "coffee-shop",
    "slow-bar",
    "offline-first",
    "sqlite",
    "thermal-printer",
    "escpos",
    "bluetooth-printer",
    "capacitor",
    "react19",
    "tablet-pos",
    "hpp-calculator"
  ],
  "author": "Kian Labs",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kianlabs/coffee-shop-pos/issues"
  },
  "homepage": "https://github.com/kianlabs/coffee-shop-pos#readme",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-updater": "^8.54.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
