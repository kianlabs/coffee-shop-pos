{
  "name": "suro-pos",
  "version": "1.1.0",
  "description": "Production-ready, offline-first Tablet POS for cafés and small food and beverage shops. Features native SQLite V7, ESC/POS Bluetooth 58mm thermal printing with raster logo, recipe-based HPP costing, and zero cloud subscription cost.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-domain.mjs && node scripts/test-guards.mjs && vitest run --coverage",
    "check": "node scripts/run-checks.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs --require-dist",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "test:e2e": "node scripts/test-e2e-exhaustive.mjs",
    "ota:pack": "node scripts/package-ota.mjs",
    "android:assets": "npm run build && node scripts/sync-android-assets.mjs",
    "apk": "bash scripts/build-apk.sh",
    "mock:sync": "node scripts/mock-sync-server.mjs --port 8787",
    "screenshots": "node scripts/capture-tablet-screenshots.mjs",
    "lint": "eslint src tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kianlabs/coffee-shop-pos.git"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "coffee-shop",
    "slow-bar",
    "offline-first",
    "sqlite",
    "thermal-printer",
    "escpos",
    "bluetooth-printer",
    "capacitor",
    "react19",
    "tablet-pos",
    "hpp-calculator"
  ],
  "author": "Kian Labs",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kianlabs/coffee-shop-pos/issues"
  },
  "homepage": "https://github.com/kianlabs/coffee-shop-pos#readme",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-updater": "^8.54.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.76.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.3",
    "sql.js": "1.17.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.5",
    "vitest": "4.1.12",
    "ws": "8.23.0"
  }
}
